    q8 -> q9 [label="\""];
    q8 -> q10 [label="salto de linea"];
    q0 -> q11 [label="@"];
    q11 -> q11 [label="letra/digito"];
    q11 -> q12 [label="valida"];
    q11 -> q13 [label="no valida"];
    q0 -> q14 [label="/"];
    q14 -> q15 [label="/"];
    q14 -> q17 [label="*"];
    q14 -> q23 [label="otro"];
    q15 -> q15 [label="otro"];
    q15 -> q16 [label="salto de linea"];
    q15 -> q16 [label="fin archivo"];
    q17 -> q17 [label="otro"];
    q17 -> q22 [label="*"];
    q17 -> q19 [label="fin archivo"];
    q22 -> q18 [label="/"];

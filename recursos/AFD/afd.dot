    q23 [shape=circle, style=filled, fillcolor=red, label="q23\nERROR"];
    q20 [shape=doublecircle, label="q20\nID/RESERVADA"];

    q0 -> q1 [label="="];
    q0 -> q1 [label="+"];
    q0 -> q24 [label="{"];
    q0 -> q24 [label="}"];
    q0 -> q24 [label="("];
    q0 -> q24 [label=")"];
    q0 -> q24 [label=","];
    q0 -> q2 [label="-"];
    q2 -> q3 [label=">"];
    q2 -> q4 [label="otro"];
    q0 -> q5 [label="digito"];
